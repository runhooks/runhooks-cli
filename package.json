{
  "name": "@runhooks/cli",
  "version": "0.1.1",
  "description": "Command-line interface for Runhooks — reliable HTTP scheduling infrastructure",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "runhooks": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "homepage": "https://runhooks.app/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runhooks/runhooks-cli.git"
  },
  "bugs": {
    "url": "https://github.com/runhooks/runhooks-cli/issues"
  },
  "keywords": [
    "cron",
    "webhook",
    "scheduler",
    "http",
    "cli",
    "runhooks",
    "job-scheduler"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2",
    "zod": "^3.24.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
